<Page x:Class="MonitorSwitch.Views.DisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:MonitorSwitch.Controls"
      xmlns:i18n="clr-namespace:MonitorSwitch.I18n"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- 不要在这里再套一层 ScrollViewer。
         WPF-UI 的 NavigationView 已经用 DynamicScrollViewer 包住了页面内容，
         外层会先量出“无限高度”，内层 ScrollViewer 的视口于是等于内容高度
         （ScrollableHeight 恒为 0）。鼠标滚轮落在内层上会被它标记 Handled=True
         却滚不动，事件就此被吞掉 —— 表现为“滚轮完全没反应，但滚动条还在”。
         直接让内容交给 NavigationView 的那一层滚动即可。

         宽度：第一列 MaxWidth 封顶、第二列吃掉剩余空间，内容左对齐且撑满可用宽度。
         直接用 StackPanel HorizontalAlignment="Left" 会收缩到最宽子元素，右侧留大片空白。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1000" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="36,20,36,36">

        <TextBlock Text="{Binding [Display.Title], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding [Display.Subtitle], Source={x:Static i18n:Localization.Instance}}"
                   Style="{StaticResource PageSubtitle}" Margin="0,2,0,14" />

        <ui:InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Margin="0,0,0,14" />

        <!-- 待应用提示条。
             这一页的所有改动都只写进草稿，点“应用”才真正下发到系统，
             避免动一下下拉框屏幕就闪一次。有未应用的改动时才出现。 -->
        <Border x:Name="PendingBar" Visibility="Collapsed" Margin="0,0,0,14"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource SystemAccentColorBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Display.Pending.Title], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                    <TextBlock x:Name="PendingDesc" Style="{StaticResource SettingDesc}"
                               Text="{Binding [Display.Pending.Desc], Source={x:Static i18n:Localization.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding [Display.Pending.Apply], Source={x:Static i18n:Localization.Instance}}" Appearance="Primary" MinWidth="80"
                               Click="OnApplyPending" />
                    <ui:Button Content="{Binding [Display.Pending.Discard], Source={x:Static i18n:Localization.Instance}}" Appearance="Secondary" MinWidth="72" Margin="8,0,0,0"
                               Click="OnDiscardPending" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 排列 -->
        <Border Style="{StaticResource CardBorder}" Padding="10,10,10,8">
            <StackPanel>
                <controls:DisplayArrangeCanvas x:Name="ArrangeCanvas" Height="280" Margin="4,2,4,0" />
                <Grid Margin="8,8,8,2">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{Binding [Display.Identify], Source={x:Static i18n:Localization.Instance}}" Appearance="Secondary" MinWidth="80" Click="OnIdentify" />
                        <ui:Button Content="{Binding [Display.Redetect], Source={x:Static i18n:Localization.Instance}}" MinWidth="80" Margin="8,0,0,0" Appearance="Secondary" Click="OnDetect" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource SettingDesc}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding [Display.ArrangeHint], Source={x:Static i18n:Localization.Instance}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 选择显示器 -->
        <TextBlock Text="{Binding [Display.SelectLabel], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" Margin="2,22,0,8" />
        <ComboBox x:Name="MonitorSelector" MinWidth="420" MaxWidth="480" HorizontalAlignment="Left"
                  SelectionChanged="OnMonitorSelected" Margin="0,0,0,14" />

        <!-- 显示器参数 -->
        <Border x:Name="SettingsCard" Style="{StaticResource CardBorder}" Padding="0,0,0,4">
            <StackPanel>
                <Grid Margin="18,16,18,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MonitorNameText" FontSize="16" FontWeight="Normal" />
                            <Border x:Name="PrimaryBadge" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding [Display.PrimaryBadge], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="MonitorSubText" Style="{StaticResource SettingDesc}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingDivider}" Margin="18,0,18,0" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.Resolution], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.ResolutionDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="ResCombo" Grid.Column="1" MinWidth="190"
                              VerticalAlignment="Center" SelectionChanged="OnResChanged" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.RefreshRate], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.RefreshRateDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="RefreshCombo" Grid.Column="1" MinWidth="190"
                              VerticalAlignment="Center" SelectionChanged="OnRefreshChanged" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.Orientation], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.OrientationDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="OrientCombo" Grid.Column="1" MinWidth="190"
                              VerticalAlignment="Center" SelectionChanged="OnOrientChanged">
                        <ComboBoxItem Content="{Binding [Display.Orient.Landscape], Source={x:Static i18n:Localization.Instance}}" />
                        <ComboBoxItem Content="{Binding [Display.Orient.Portrait], Source={x:Static i18n:Localization.Instance}}" />
                        <ComboBoxItem Content="{Binding [Display.Orient.LandscapeFlipped], Source={x:Static i18n:Localization.Instance}}" />
                        <ComboBoxItem Content="{Binding [Display.Orient.PortraitFlipped], Source={x:Static i18n:Localization.Instance}}" />
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.Scale], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.ScaleDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="ScaleCombo" Grid.Column="1" MinWidth="190"
                              VerticalAlignment="Center" IsEnabled="False" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="HDR" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="HdrDesc" Text="{Binding [Display.HdrDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="HdrToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnHdrToggled" Unchecked="OnHdrToggled" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.Enable], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.EnableDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="EnableToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnEnableToggled" Unchecked="OnEnableToggled" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />

                <Grid Style="{StaticResource SettingRow}" Margin="18,12,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Display.SetPrimary], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Display.SetPrimaryDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:Button x:Name="SetPrimaryBtn" Grid.Column="1" Content="{Binding [Display.SetPrimary], Source={x:Static i18n:Localization.Instance}}"
                               VerticalAlignment="Center"
                               Appearance="Secondary" Click="OnSetPrimary" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 未启用的显示器 -->
        <TextBlock x:Name="InactiveTitle" Text="{Binding [Display.InactiveTitle], Source={x:Static i18n:Localization.Instance}}"
                   Style="{StaticResource SettingTitle}" Margin="2,22,0,8" Visibility="Collapsed" />
        <Border x:Name="InactiveCard" Style="{StaticResource CardBorder}" Padding="18,8,18,8" Visibility="Collapsed">
            <StackPanel x:Name="InactiveList" />
        </Border>
        </StackPanel>
    </Grid>
</Page>

<Page x:Class="MonitorSwitch.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:i18n="clr-namespace:MonitorSwitch.I18n"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- 滚动由 NavigationView 的 DynamicScrollViewer 负责，这里不要再套 ScrollViewer。

         宽度：外层 Grid 的第一列用 MaxWidth 封顶，第二列吃掉剩余空间 ——
         这样内容既保持左对齐，又能撑满可用宽度。
         直接用 StackPanel HorizontalAlignment="Left" 会让它收缩到最宽子元素的宽度，
         卡片就只剩 ~400px，右半边整片空白。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1000" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="36,20,36,36">

        <TextBlock Text="{Binding [Settings.Title], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding [Settings.Subtitle], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource PageSubtitle}" Margin="0,2,0,14" />

        <ui:InfoBar x:Name="SavedBar" IsOpen="False" IsClosable="True" Severity="Success"
                    Title="{Binding [Settings.Saved], Source={x:Static i18n:Localization.Instance}}"
                    Message="{Binding [Settings.SavedMsg], Source={x:Static i18n:Localization.Instance}}" Margin="0,0,0,14" />

        <TextBlock Text="{Binding [Settings.SectionAppearance], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource CardBorder}" Padding="0">
            <StackPanel>
            <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Settings.Theme], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                    <TextBlock Text="{Binding [Settings.ThemeDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                </StackPanel>
                <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="{Binding [Settings.ThemeAuto], Source={x:Static i18n:Localization.Instance}}" />
                    <ComboBoxItem Content="{Binding [Settings.ThemeLight], Source={x:Static i18n:Localization.Instance}}" />
                    <ComboBoxItem Content="{Binding [Settings.ThemeDark], Source={x:Static i18n:Localization.Instance}}" />
                </ComboBox>
            </Grid>

            <Border Style="{StaticResource SettingDivider}" />

            <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Settings.Language], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                    <TextBlock Text="{Binding [Settings.LanguageDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                </StackPanel>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                          SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="{Binding [Settings.LanguageAuto], Source={x:Static i18n:Localization.Instance}}" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="简体中文" />
                </ComboBox>
            </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding [Settings.SectionStartup], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SectionHeader}" Margin="2,20,0,8" />
        <Border Style="{StaticResource CardBorder}" Padding="0,4,0,4">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.AutoStart], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Settings.AutoStartDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.StartMinimized], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Settings.StartMinimizedDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnStartMinimizedToggled" Unchecked="OnStartMinimizedToggled" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.CloseToTray], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Settings.CloseToTrayDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnCloseToTrayToggled" Unchecked="OnCloseToTrayToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding [Settings.SectionApply], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SectionHeader}" Margin="2,20,0,8" />
        <Border Style="{StaticResource CardBorder}" Padding="0,4,0,4">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.RevertGuard], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding [Settings.RevertGuardDesc], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="RevertGuardToggle" Grid.Column="1" VerticalAlignment="Center"
                                     Checked="OnRevertGuardToggled" Unchecked="OnRevertGuardToggled" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.DataDir], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="DataDirText" Style="{StaticResource SettingDesc}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{Binding [Common.Open], Source={x:Static i18n:Localization.Instance}}" Appearance="Secondary" MinWidth="72"
                               VerticalAlignment="Center" Click="OnOpenDataDir" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding [Settings.SectionAbout], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SectionHeader}" Margin="2,20,0,8" />
        <Border Style="{StaticResource CardBorder}" Padding="0,4,0,4">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}" Margin="18,10,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.AboutName], Source={x:Static i18n:Localization.Instance}}" Style="{StaticResource SettingTitle}" />
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                                   Text="{Binding [Settings.AboutDesc], Source={x:Static i18n:Localization.Instance}}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" Text="v1.0.0"
                               VerticalAlignment="Center" Style="{StaticResource SettingDesc}" />
                </Grid>
                <Border Style="{StaticResource SettingDivider}" />
                <TextBlock Margin="18,10,18,10" Style="{StaticResource SettingDesc}"
                           Text="{Binding [Settings.Credits], Source={x:Static i18n:Localization.Instance}}" />
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</Page>

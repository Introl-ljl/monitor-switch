<Application x:Class="MonitorSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MonitorSwitch.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 注意：WPF-UI 的 ThemesDictionary / ControlsDictionary 不在这里声明。
                 它们会实例化整套控件模板，实测把常驻内存从约 37MB 抬到约 62MB。
                 托盘常驻时完全用不到，因此改由 ThemeService.EnsureUiResources()
                 在首次真正需要 UI 时再加载（见该方法的说明）。 -->

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

            <!-- 字体：WPF-UI 默认把 ContentControlThemeFontFamily 设为 "Segoe Ui"，
                 而 Segoe UI 完全不含中文字形（实测 CharacterToGlyphMap 缺失全部 CJK）。
                 中文只能靠 WPF 的字体回退渲染，回退字体的度量与 Segoe UI 不匹配，
                 表现为中文字形比数字/英文偏大、笔画偏细发飘、基线与西文不对齐。
                 这里显式指定中文字体优先，西文仍由 Segoe UI 系列承担（WPF 会按字符逐个回退）。 -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

            <!-- 覆盖 WPF-UI 的主题字体，让控件模板（Button/ComboBox/NavigationView 等）也用同一套字体 -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <!-- WPF-UI 的 FontIcon 默认字体是 Microsoft YaHei UI，不含图标字形，
                 所有图标都会渲染成方框；需要统一改为 Fluent/MDL2 图标字体。
                 ！！但这条 Style 引用 ui:FontIcon 类型，会让 Wpf.Ui.dll（5.7MB）
                 在启动阶段就被加载，托盘常驻占用降不下来（实测 55MB → 49MB）。
                 因此它被移到 ThemeService.EnsureUiResources() 里，
                 随 WPF-UI 资源一起延迟加载。 -->

            <!-- 文字渲染：
                 1) Foreground —— TextBlock 默认前景是系统黑色，深色背景下几乎不可见。
                 2) TextRenderingMode=Grayscale —— 这是解决“UI 偏绿”的关键。
                    ClearType 是子像素渲染，会在每个字形边缘画出橙/蓝/绿的彩色条纹。
                    深色背景 + 中文小字号时这些彩边最刺眼：实测单像素绿色偏移可达 +75，
                    整片文字有 36.8% 的像素带明显色偏，肉眼看就是一层洗不掉的脏绿。
                    改用灰度抗锯齿后彩色像素占比降到 0%，字形边缘只剩中性灰过渡。
                    （WinUI 3 与 macOS 在深色界面上同样不做子像素渲染。）
                 3) TextFormattingMode=Display —— 按整数像素对齐字形，边缘更干净；
                    Ideal 会做亚像素定位，配合 ClearType 时彩色边最严重（实测 67.5%）。
                 4) ClearTypeHint 保留 —— 灰度模式下它不影响结果，但保留可避免
                    某些控件模板显式开启 ClearType 时又退回彩色渲染。 -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            </Style>

            <!-- 大字号标题沿用同一套渲染设置 -->
            <Style x:Key="LargeTextBase" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            </Style>

            <!-- 卡片表面。
                 WPF-UI 的 CardBackgroundFillColorDefaultBrush 是 #0DFFFFFF（5% 白），
                 叠在页面底色 #272727 上几乎看不出差别 —— 实测卡片与页面背景
                 都是 RGB(39,39,39)，对比度 1.00:1，卡片完全没有浮起来，
                 只剩 1px 描边勉强分隔，这是界面显得“平、糊、怪”的主因。
                 这里改用明确的表面色：深色主题比页面亮一档，浅色主题纯白。 -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF303030" />
            <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#1FFFFFFF" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <!-- 页面标题：Microsoft YaHei UI 只有 290(Light)/Normal/Bold 三档，没有 SemiBold。
                 请求 SemiBold 会被 WPF 匹配到 Bold，中文标题因此明显过粗、笔画粘连。
                 这里改用 Normal：粗细恢复正常。 -->
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource LargeTextBase}">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="34" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SettingDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 分组标题（“外观”“启动”“应用模板”…）：比正文小、用次级色，
                 形成清晰的层级，而不是和正文同样粗细地糊在一起。 -->
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="2,0,0,8" />
            </Style>

            <!-- 设置行：左侧说明 + 右侧控件 -->
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>

            <Style x:Key="SettingDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Margin" Value="18,0,18,0" />
            </Style>

            <!-- 小徽标（“主显示器”“当前使用中”）：中性填充 + 细描边，不抢主内容 -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

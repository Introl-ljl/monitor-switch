<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MonitorSwitch</RootNamespace>
    <AssemblyName>MonitorSwitch</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>MonitorSwitch 显示器助手</Product>
    <Description>快速切换显示器配置的 Windows 托盘工具</Description>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试工程访问 internal 成员（CLI 解析器、Salvage、NormalizeRefresh 等纯逻辑） -->
    <InternalsVisibleTo Include="MonitorSwitch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面文案。用 WPF 的 Resource（而非 EmbeddedResource）：
         本项目是 UseWPF=true，SDK 的资源管线会把 EmbeddedResource 交给 WPF 的
         .g.resources 生成器，JSON 会被静默丢弃（实测组件清单里只剩 g.resources）。
         改用 Resource 后可通过 Application.GetResourceStream 按 pack URI 读取。 -->
    <None Remove="I18n\strings.en.json" />
    <None Remove="I18n\strings.zh-CN.json" />
    <Resource Include="I18n\strings.en.json" />
    <Resource Include="I18n\strings.zh-CN.json" />
  </ItemGroup>

</Project>
